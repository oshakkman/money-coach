# Copy this file to ".env.local" (local computer) or enter these values in your
# hosting provider's "Environment Variables" settings (online version).
# NEVER commit the real values to GitHub.

# Your Anthropic API key from https://console.anthropic.com (starts with sk-ant-)
ANTHROPIC_API_KEY=

# A private access code YOU invent (at least 12 characters). Rafiq will ask for
# it once on each device before it can use Claude. This stops strangers who
# find your website address from using (and paying for) your API key.
RAFIQ_ACCESS_CODE=

# Optional. Leave blank for the default (claude-opus-5-5).
RAFIQ_MODEL=
